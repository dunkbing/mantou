{
  "name": "mantou-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Mantou: a native GUI framework for Bun + TypeScript",
  "type": "module",
  "bin": {
    "mantou": "./runtime/cli.ts"
  },
  "exports": {
    ".": "./runtime/index.ts",
    "./solid": "./runtime/solid/renderer.ts",
    "./jsx-runtime": "./runtime/jsx-runtime.ts",
    "./jsx-dev-runtime": "./runtime/jsx-runtime.ts",
    "./headless": "./runtime/headless.ts",
    "./mock": "./runtime/mock.ts",
    "./preload": "./runtime/solid/preload.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:core": "cargo build --release --manifest-path core/Cargo.toml",
    "gen": "bun schema/gen.ts",
    "gen:check": "bun schema/gen.ts --check",
    "typecheck": "bun check",
    "test": "bun test runtime examples/counter schema",
    "test:core": "cargo test --manifest-path core/Cargo.toml -p mantou-tree",
    "selftest": "bun runtime/main.ts spike/selftest.ts --title \"Mantou self-test\"",
    "counter": "bun runtime/cli.ts run examples/counter/main.tsx --title Mantou",
    "app": "bun runtime/main.ts spike/app.ts --title \"Mantou demo\"",
    "docs": "bun --cwd website run dev",
    "test:headless": "bun test tests examples/toggle.test.tsx"
  },
  "dependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "babel-preset-solid": "1.9.16",
    "solid-js": "1.9.18"
  },
  "devDependencies": {
    "@types/babel__core": "7.20.5",
    "@types/bun": "^1.4.4"
  }
}
