{
  "name": "mantou-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Mantou: a native GUI framework for Bun + TypeScript",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dunkbing/mantou.git"
  },
  "homepage": "https://mantou.dunkbing.dev",
  "keywords": [
    "gui",
    "native",
    "desktop",
    "bun",
    "solid",
    "wgpu"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "type": "module",
  "bin": {
    "mantou": "./runtime/cli.ts"
  },
  "exports": {
    ".": "./runtime/index.ts",
    "./solid": "./runtime/solid/renderer.ts",
    "./jsx-runtime": "./runtime/jsx-runtime.ts",
    "./jsx-dev-runtime": "./runtime/jsx-runtime.ts",
    "./headless": "./runtime/headless.ts",
    "./mock": "./runtime/mock.ts",
    "./preload": "./runtime/solid/preload.ts",
    "./images": "./runtime/images.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "runtime",
    "!runtime/**/*.test.ts",
    "!runtime/**/*.test.tsx",
    "core/Cargo.toml",
    "core/Cargo.lock",
    "core/crates",
    "!core/crates/*/tests",
    "README.md"
  ],
  "scripts": {
    "build:core": "cargo build --release --manifest-path core/Cargo.toml",
    "gen": "bun schema/gen.ts",
    "gen:check": "bun schema/gen.ts --check",
    "typecheck": "bun check",
    "test": "bun test runtime examples/counter schema",
    "test:core": "cargo test --manifest-path core/Cargo.toml -p mantou-tree -p mantou-text -p mantou-image && cargo test --release --manifest-path core/Cargo.toml -p mantou-ffi -p mantou-html --lib",
    "selftest": "bun runtime/main.ts spike/selftest.ts --title \"Mantou self-test\"",
    "counter": "bun runtime/cli.ts run examples/counter/main.tsx --title Mantou",
    "todos": "bun runtime/cli.ts run examples/todos/main.tsx --width 420 --height 520",
    "showcase": "bun runtime/cli.ts run examples/showcase/main.tsx --width 800 --height 500",
    "gallery": "bun runtime/cli.ts run examples/gallery/main.tsx",
    "mail": "bun runtime/cli.ts run examples/mail/main.tsx",
    "webview": "bun runtime/cli.ts run examples/webview/main.tsx",
    "screenshots": "bun --preload ./runtime/solid/preload.ts scripts/screenshots.tsx",
    "app": "bun runtime/main.ts spike/app.ts --title \"Mantou demo\"",
    "docs": "bun --cwd website run dev",
    "test:headless": "bun test tests examples/toggle.test.tsx examples/todos/Todos.test.tsx examples/mail"
  },
  "dependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "babel-preset-solid": "1.9.16",
    "solid-js": "1.9.18"
  },
  "devDependencies": {
    "@types/babel__core": "7.20.5",
    "@types/bun": "^1.4.4"
  }
}
